{
  "name": "forme-styling-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "check": "node --check src/app.js && node --check src/styling.js && node --check server.js && node --check public/app.js && node --check scripts/check-model.js",
    "check:model": "node --env-file-if-exists=.env scripts/check-model.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  }
}
